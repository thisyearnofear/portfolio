{
  "name": "papa-portfolio",
  "version": "1.0.0",
  "description": "Papa's portfolio website showcasing projects and work",
  "default": "dist/index.html",
  "scripts": {
    "start": "parcel src/index.html --open",
    "clean": "rm -rf dist/*",
    "build:parcel": "parcel build src/index.html --no-content-hash --no-source-maps --public-url ./",
    "build": "npm run clean && npm run build:parcel"
  },
  "keywords": [
    "portfolio",
    "web development",
    "projects"
  ],
  "author": "Papa",
  "license": "MIT",
  "homepage": "https://papa.dev",
  "devDependencies": {
    "parcel": "latest"
  },
  "dependencies": {
    "gsap": "^3.7.1",
    "imagesloaded": "^4.1.4",
    "split-type": "^0.2.5"
  }
}
